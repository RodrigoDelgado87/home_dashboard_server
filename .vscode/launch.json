{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HomeDash (uvicorn local)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "DATA_DIR": "${workspaceFolder}/data",
        "HOST_PROC": "/proc",
        "HOST_ROOT": "/",
        "METRICS_INTERVAL": "2"
      },
      "jinja": true,
      "justMyCode": true
    }
  ]
}
